# Example environment configuration for IoT EV Fleet Backend
# Copy to .env and set appropriate values. Do NOT commit real secrets.

# Database
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# Authentication / JWT
JWT_SECRET=please_change_me_to_a_long_random_value
JWT_ALG=HS256

# CORS allowed origins
# Use "*" to allow all (development only).
# For multiple origins, provide a comma-separated list, e.g.:
# http://localhost:3000,https://admin.example.com
CORS_ORIGINS=*

# WebSocket base path
WS_BASE_PATH=/ws
