# Copy this file to .env and set the correct values.
# DATABASE_URL follows SQLAlchemy URL pattern:
# For Postgres: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
# For MySQL: mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME
# For SQLite (development only): sqlite:///./app.db
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
